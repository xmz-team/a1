#!/bin/bash

script_path="$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)"

source ${script_path}/ci/env.sh

"${script_path}/ci/generate-version.sh" "a1"

lua_patch_file="${script_path}/paths/loslib_lsystem.patch"
cd libs/lua
cp loslib.c loslib.c.orig
patch -p0 < ${lua_patch_file}
export CC="$(which cc)"
make clean
make CC=${CC} a
rm loslib.c && mv loslib.c.orig loslib.c

cd ${script_path}

c++ -ObjC++ \
 $CXXFLAGS ${lib_path[@]} \
 ${src_path}/src/cxxa1.cc -o cxxa1 \
 -lm libs/lua/liblua.a

#chown 0:0 cxxa1
#chmod 4755 cxxa1


#!/bin/bash

#set -x

if [ -f '/etc/profile' ]; then
    source /etc/profile
elif [ -f '/var/jb/etc/profile' ]; then
    source /var/jb/etc/profile
else
    echo 'Where the fuck "profile"?' 1>&2
fi

if [ "$(dpkg --print-architecture)" = "iphoneos-arm64" ]; then
    jb="/var/jb"
else
    if [ "$(dpkg --print-architecture)" = "iphoneos-arm64e" ]; then
        unset jb;
        jb="$(jbroot)"
    else
        unset jb;
        jb=""
    fi
fi

jb_a1="$jb/a1"

_finish(){
	f="${1}"
	[ -z "${f}" ] || [ -z "${SILEO}" ] && return
	read -r fd ver <<-EOF                    
			${SILEO}                                    
			EOF
	[ "${ver}" -ge 1 ] || return
	echo "finish:${f}" >&"${fd}"
}

echo "Tweak by LF"
echo "Sto lavorando per te!"
echo "------------------------------"
echo "|Author: LF                  |"
echo "|Maintainer: LF, AD, XMZ     |"
echo "|Project: A1                 |"
echo "|Organization(QQ): 1030152896|"
echo "------------------------------"

echo "setting..."
chown 0:0 $jb/usr/local/bin/a1cil
chmod 755 $jb/usr/local/bin/a1cil
chown 0:0 -R $jb_a1/bin

chmod 4755 $jb_a1/bin/cxxa1
chmod 4755 $jb_a1/bin/cxxa1ctl
chmod 4755 $jb_a1/bin/cxxa1mod
chmod 4755 $jb_a1/bin/cxxa1pm

ln -sf $jb_a1/bin/bundle $jb/usr/bin/
ln -sf $jb_a1/bin/bundle_pid $jb/usr/bin/
ln -sf $jb_a1/bin/pid_bundle $jb/usr/bin/

ln -sf $jb_a1/bin/flock $jb/usr/bin/
ln -sf $jb_a1/bin/flock-ios $jb/usr/bin/

ln -sf $jb_a1/bin/myini $jb/usr/bin/

orig_path=$(pwd)

if [ "$(dpkg --print-architecture)" = "iphoneos-arm64e" ]; then
    [ -d "/rootfs" ] && cd /rootfs/var
    [ ! -d "jb" ] && ln -s / ./jb
    ls -l /rootfs/var/jb
    cd "$jb"
    cd var && ln -sf "$(jbroot)/a1"
    cd "$jb_a1"
    touch .type_is_roothide
    cd bin && ln -sf "$(jbroot)" .jbroot
    cd $orig_path
fi
if [ "$(dpkg --print-architecture)" = "iphoneos-arm64" ]; then
    cd $jb_a1
    touch .type_is_rootless
    cd $orig_path
elif [ "$(dpkg --print-architecture)" = "iphoneos-arm" ]; then
    cd $jb_a1
    touch .type_is_rootful
    cd $orig_path
else
    if [ -d "$jb_a1" ]; then
        cd $jb/a1
        touch .type_is_undefined
        cd $orig_path
    elif [ -d "$jb/a1" ]; then
        cd $jb/a1
        touch .type_is_undefined
        cd $orig_path
    elif [ -f $(command -v jbroot) ] && [ -d "$(jbroot)/a1" ]; then
        cd $(jbroot)/a1
        touch .type_is_undefined
        cd $orig_path
    elif [ -d "$jb/var/a1" ]; then
        cd $jb/var/a1
        touch .type_is_undefined
        cd $orig_path
    else
        cd $orig_path
        echo "[Error]: unable to determine your jailbreak environment" >&2
        echo "[Error]: a1 does not support this environment: $(dpkg --print-architecture), or you’re not jailbreaking iOS" >&2
        unset orig_path
        exit 1
    fi
fi

unset orig_path

echo "A1 install done."
echo "Enjoy！"

_finish usreboot
